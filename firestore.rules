rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ══════════════════════════════════════════════════════════════════
       Yazma yetkisi tek bir Firebase Authentication hesabına bağlıdır.

       Yetki kararı tamamen sunucu tarafındadır: istemci kodu ne yaparsa
       yapsın, arayüz zorla açılsa veya istek doğrudan API'ye atılsa bile
       bu kural geçerlidir.

       Önceki hali "allow write: if true" idi — kimlik doğrulaması yoktu,
       internetteki herkes yazabiliyordu.

       Admin hesabı değişirse aşağıdaki UID güncellenmeli. Birden fazla
       yönetici gerekirse isAdmin() gövdesi bir /admins/{uid} koleksiyonu
       kontrolüne çevrilebilir; tek yönetici için UID doğrudan gömülü
       tutuluyor, böylece her istekte fazladan doküman okuması olmuyor.
       ══════════════════════════════════════════════════════════════════ */

    function isAdmin() {
      return request.auth != null
          && request.auth.uid == 'rz7BFfSrRycjqnlWx5ofqjiFEsr1';
    }

    // İlanlar — okuma herkese açık (site içeriği), yazma yalnızca admin
    match /listings/{doc} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Site ayarları (logo, başlık, telefon, tema) — okuma herkese açık
    match /settings/{doc} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    /* İletişim formu — herkes gönderebilir, alan adları ve boyutlar
       doğrulanır. Alan adları app.js'teki gönderimle birebir eşleşir;
       başka bir alan gönderilirse yazma reddedilir. Boyut sınırları dev
       yüklerle doküman şişirme ve kota tüketmeye karşı koruma sağlar.
       Talepleri yalnızca admin okuyabilir. */
    match /contacts/{doc} {
      allow create: if request.resource.data.keys().hasOnly(['from_name', 'from_phone', 'sqm', 'budget', 'message', 'createdAt'])
                    && request.resource.data.from_name  is string
                    && request.resource.data.from_name.size()  <= 100
                    && request.resource.data.from_phone is string
                    && request.resource.data.from_phone.size() <= 30
                    && request.resource.data.sqm        is string
                    && request.resource.data.sqm.size()        <= 50
                    && request.resource.data.budget     is string
                    && request.resource.data.budget.size()     <= 50
                    && request.resource.data.message    is string
                    && request.resource.data.message.size()    <= 2000;
      allow read:   if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Tanımlanmamış her yol kapalı
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
