rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    /* ══════════════════════════════════════════════════════════════════
       GEÇİCİ KİLİT — Firebase Authentication kurulana kadar geçerlidir.

       Önceki hali: /listings için "allow write: if true" idi; internetteki
       herkes projeye dosya yükleyebilir ve mevcut fotoğrafları silebilirdi.

       NOT: Bu dosya bugüne kadar HİÇ deploy edilmedi — firebase.json'da
       "storage" bloğu yoktu. Canlı kurallar Console'un varsayılanıydı.
       ══════════════════════════════════════════════════════════════════ */

    // İlan fotoğrafları — okuma herkese açık (site görselleri), yazma kapalı
    match /listings/{allPaths=**} {
      allow read:  if true;
      allow write: if false;
    }

    // Diğer tüm yollar kapalı
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
